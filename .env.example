# ─────────────────────────────────────────────────────────────
# 服务运行参数（可选，含默认值）
# ─────────────────────────────────────────────────────────────
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8833
SERVICE_WORKERS=1
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# LLM（必填）— OpenAI 兼容接口，默认 Qwen
# ─────────────────────────────────────────────────────────────
LLM_API_KEY=your_qwen_api_key_here
LLM_BASE_URL=http://47.242.205.13:8110/v1
LLM_MODEL=Qwen/Qwen3.5-397B-A17B
# 视觉输入：auto / true / false（默认 auto，多模态模型按需启用截图）
BROWSER_USE_VISION=auto
# 截图细节：low / high / auto（默认 low，控制图片负载）
BROWSER_USE_VISION_DETAIL=low

# ─────────────────────────────────────────────────────────────
# 接口鉴权（必填）— 业务路由的 Bearer Token
# ─────────────────────────────────────────────────────────────
PUBLISH_API_TOKEN=change_me_to_a_strong_secret

# ─────────────────────────────────────────────────────────────
# 运行期目录（可选）
# ─────────────────────────────────────────────────────────────
APP_DATA_DIR=data
APP_LOG_DIR=logs
APP_REMOTE_PROFILE_DIR=data/profiles

# ─────────────────────────────────────────────────────────────
# 僵尸 pending 渠道清理（可选）
# 用户发起登录会留下 pending 渠道，若放弃登录则永远停在 pending（无 cookie）。
# 后台周期清扫创建超过 TTL 仍未绑定的 pending 渠道。TTL 须远大于真实登录耗时。
# TTL<=0 关闭清扫。
# ─────────────────────────────────────────────────────────────
PENDING_CHANNEL_TTL_SECONDS=1800
PENDING_CHANNEL_SWEEP_INTERVAL_SECONDS=600

# ─────────────────────────────────────────────────────────────
# 浏览器（可选）— Docker 默认使用内置 Playwright Chromium
# ─────────────────────────────────────────────────────────────
# BROWSER_EXECUTABLE_PATH=/ms-playwright/chromium-*/chrome-linux/chrome
# BROWSER_TYPE=chrome

# ─────────────────────────────────────────────────────────────
# 远程登录并发与端口
# 每个登录会话会拉起 Chrome + Xvnc，约占 400MB 内存，
# 按服务器内存设置（如 32GB → 40）。
# ─────────────────────────────────────────────────────────────
MAX_REMOTE_LOGIN_SESSIONS=30
# ── 预热登录会话池 ──────────────────────────────────────────────
# 每平台后台预热的空闲会话数；0=关闭预热（默认，行为同以前）。开启后用户请求
# 来时直接复用，省掉现起 Xvnc+Chrome 的 3–10s 等待。预热占用计入上面的总容量。
REMOTE_LOGIN_WARM_PER_PLATFORM=0
# 要预热的平台（逗号分隔），只有带登录页的平台会生效
REMOTE_LOGIN_WARM_PLATFORMS=toutiao,sohu
# 维护巡检间隔（秒）：补水位、回收僵死/过期会话
REMOTE_LOGIN_WARM_CHECK_INTERVAL=30
# 预热会话存活上限（秒）：超过则回收重建，避免登录页临时 token 过期
REMOTE_LOGIN_WARM_TTL=600
# ── 登录 cookie 自动检测 ────────────────────────────────────────
# 真实登录会话后台轮询浏览器，检测到平台登录 cookie 即自动绑定，免去前端显式
# 调用 save-cookie（该接口仍保留为兜底）。轮询间隔（秒）。
REMOTE_LOGIN_COOKIE_POLL_INTERVAL=3
# 连续命中多少次才认定登录稳定完成（防抖，避免抓到登录中途的半成品 cookie）
REMOTE_LOGIN_COOKIE_POLL_STABLE=2
# 单个会话自动轮询的最长时长（秒）：超时停止轮询，仅保留手动 save-cookie 兜底
REMOTE_LOGIN_COOKIE_POLL_MAX_WAIT=600

# ── 登录成功后的「宽限期」回收 ──────────────────────────────────
# 抓到 cookie 后不立刻拆会话，让 viewer 多停留一会（明确「登录成功」、允许自行关闭/
# 简单查看），避免画面无征兆 fail-to-connect。回收取三者最早：空闲 / TTL / 显式关闭。
# 自捕获起的硬性存活上限（秒）：无论是否还连着都回收，兜底「开着页面不动」占 slot。设 0 关闭。
REMOTE_LOGIN_POST_CAPTURE_TTL=90
# 无活跃 viewer 连接的空闲回收阈值（秒）：用户关掉页面后这么久即拆。设 0 关闭。
REMOTE_LOGIN_POST_CAPTURE_IDLE=30
# 宽限会话回收巡检间隔（秒）
REMOTE_LOGIN_REAP_INTERVAL=5

# 登录 live url 对外暴露的公网 base。反向代理需把 {base}/vnc/{session_id}/ 转发到
# 本服务端口；留空则回退到 http://127.0.0.1:{端口}（仅本地开发可直接打开）。
REMOTE_PUBLIC_BASE_URL=http://222.212.94.89
# Xvnc 虚拟显示号起点（X display number，如 :100/:101，不是 TCP 端口）。
# 避开发布浏览器固定用的 :99；走本机 unix socket，与防火墙无关。
DISPLAY_BASE=100
# KasmVNC 串流的 TCP 端口起点（6900+N）。仅监听 127.0.0.1，由本服务的
# 反向代理(/vnc/...)内部访问，不对公网暴露，无需在防火墙放行。
KASMVNC_PORT_BASE=6900
# Chrome 远程调试 CDP 端口段。Chrome 绑 127.0.0.1，纯本机回环，无需防火墙放行；
# 避开服务端口 8833 即可。
CDP_PORT_RANGE=9000-9999
# 以下可执行文件路径在 Docker 镜像中已预置，本地非容器部署时按需配置
# KASMVNC_BIN=Xvnc
# REMOTE_VNC_SCREEN=1920x1080x24

# ─────────────────────────────────────────────────────────────
# 远程登录画面质量（扫码模糊时可上调）
# ─────────────────────────────────────────────────────────────
XVFB_SCREEN=1920x1080x24
REMOTE_BROWSER_WINDOW_WIDTH=1920
REMOTE_BROWSER_WINDOW_HEIGHT=1080
REMOTE_VIEWER_MAX_WIDTH=1440
REMOTE_VIEWER_MAX_HEIGHT=900
# 注意：REMOTE_VIEWER_* 仅作用于「发布实时预览」(CDP screencast)，质量 0-100。
REMOTE_VIEWER_JPEG_QUALITY=85
# 远程登录 KasmVNC 串流不显式钳制画质，交还给 KasmVNC 自适应（同 a2a-browser）。
# 此前固定 -JpegVideoQuality/-WebpVideoQuality 反而会让登录页进入视频模式后画质
# 被锁死、无法随带宽回升，表现为"刚连上清晰、几秒后变糊"，故移除。

# ─────────────────────────────────────────────────────────────
# SQLite 任务/渠道存储 — 持久化发布/登录记录与渠道 cookie（无 TTL）。单节点自部署，
# 一个文件即可；相对路径以项目根为基准（容器内记得把该路径挂到持久卷）。
# 留空 SQLITE_PATH 则回退到内存存储（仅本地开发/测试，重启即丢）。
# ─────────────────────────────────────────────────────────────
SQLITE_PATH=data/app.db

# ─────────────────────────────────────────────────────────────
# 多 IP 代理 — 每个渠道绑定独立静态代理 IP，登录和发文同 IP 出口，避免风控。
# 启用需同时提供 proxies.yaml（参考 proxies.yaml.example）。
# PROXY_ENABLED=false（默认）时全部直连，行为与未集成代理时完全一致。
# ─────────────────────────────────────────────────────────────
PROXY_ENABLED=false
# 代理配置文件路径（默认项目根目录 proxies.yaml）
# PROXY_CONFIG_PATH=proxies.yaml
# 渠道→IP 绑定关系持久化路径（默认 data/proxy_assignments.json）
# PROXY_ASSIGNMENTS_PATH=data/proxy_assignments.json
