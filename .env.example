LLM_API_KEY=your_qwen_api_key_here
LLM_BASE_URL=http://47.242.205.13:8110/v1
LLM_MODEL=Qwen/Qwen3.5-397B-A17B
BROWSER_USE_VISION=auto
BROWSER_USE_VISION_DETAIL=low
SOHU_ACCOUNT_ID=
# Optional per-user Sohu account id mapping, for example: user1:122702850,user2:122580788
SOHU_ACCOUNT_ID_MAP=
# Optional legacy fallback. Used only when LLM_API_KEY is empty.
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
PUBLISH_API_TOKEN=change_me_to_a_strong_secret

# Optional local override. Docker uses the bundled Playwright Chromium by default.
# BROWSER_EXECUTABLE_PATH=/ms-playwright/chromium-*/chrome-linux/chrome

APP_DATA_DIR=data
APP_LOG_DIR=logs
APP_REMOTE_PROFILE_DIR=data/remote_profiles
REMOTE_LOGIN_TIMEOUT_SECONDS=600
EDGE_CDP_PORT=9227
LOG_LEVEL=INFO

# Remote login concurrency. Each active login session spawns Chrome + Xvnc + cloudflared,
# consuming ~400MB RAM. Set based on available server memory (e.g., 32GB RAM → 40 sessions).
MAX_REMOTE_LOGIN_SESSIONS=40
# Display port range for Xvnc. Must not conflict with other services on the host.
DISPLAY_BASE=100
# WebSocket port range for KasmVNC. Keep within server firewall whitelist (e.g., 8000-9999).
KASMVNC_PORT_BASE=6900
# CDP port range for Chrome remote debugging. Must be within server firewall whitelist.
CDP_PORT_RANGE=8000-9999

# Remote login viewer quality. Increase these if QR login is still blurry.
XVFB_SCREEN=1920x1080x24
REMOTE_BROWSER_WINDOW_WIDTH=1440
REMOTE_BROWSER_WINDOW_HEIGHT=900
REMOTE_VIEWER_MAX_WIDTH=1440
REMOTE_VIEWER_MAX_HEIGHT=900
REMOTE_VIEWER_JPEG_QUALITY=85

# Redis-backed job state. Set this in production to share job state across workers/containers.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=browser_use:publish
REDIS_JOB_TTL_SECONDS=86400
