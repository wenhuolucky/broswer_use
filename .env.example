# DeepSeek API Key (去 platform.deepseek.com 注册获取)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 浏览器可执行文件路径 (可选, 不设置则自动检测 Edge > Chrome > 系统默认)
# BROWSER_EXECUTABLE_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

# 浏览器类型 (可选): edge / chrome（不设置时默认 Chrome，自动检测）
# BROWSER_TYPE=edge

# 当前使用的 LLM 提供商 (mimo | minimax | deepseek)，文章生成默认 mimo
# LLM_PROVIDER=mimo

# Mimo API Key（小米 MiMo Token Plan，文章生成推荐）
# 获取：platform.xiaomimimo.com → Console → API Keys
# MIMO_API_KEY=tp-xxx

# Mimo 模型名（可选）
# MIMO_MODEL=mimo-v2-pro

# DeepSeek API Key (浏览器自动化专用)
# DEEPSEEK_API_KEY=sk-xxx
